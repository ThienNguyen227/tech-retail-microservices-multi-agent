generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// 1. ORDER
// ========================================

model Order {
  order_id                  Int      @id @default(autoincrement())
  order_code                String   @unique
  order_user_id             Int      // LF

  order_order_processing_status_id Int
  order_order_payment_status_id    Int
  order_order_delivery_method_id   Int
  order_order_payment_method_id    Int

  order_recipient_name      String
  order_recipient_phone     String
  order_address_line        String
  order_ward                String
  order_province            String

  order_subtotal            Decimal
  order_shipping_fee        Decimal
  order_discount_amount     Decimal
  order_total_amount        Decimal

  order_created_at          DateTime    @default(now())
  order_updated_at          DateTime    @updatedAt

  // Relations
  order_processing_status         OrderProcessingStatus @relation(fields: [order_order_processing_status_id], references: [order_processing_status_id])

  order_payment_status            OrderPaymentStatus @relation(fields: [order_order_payment_status_id], references: [order_payment_status_id])

  order_delivery_method           OrderDeliveryMethod @relation(fields: [order_order_delivery_method_id], references: [delivery_method_id])

  order_payment_method            OrderPaymentMethod @relation(fields: [order_order_payment_method_id], references: [payment_method_id])

  order_item                OrderItem[]

  @@map("order")

  @@index([order_user_id])
  @@index([order_order_processing_status_id])
  @@index([order_order_payment_status_id])
  @@index([order_order_delivery_method_id])
  @@index([order_order_payment_method_id])
}


// ========================================
// 2. ORDER ITEM
// ========================================

model OrderItem {
  order_item_id              Int    @id @default(autoincrement())
  order_item_order_id        Int
  order_item_sku             String
  order_item_serial_number   String?
  order_item_product_name    String
  order_item_product_image   String
  order_item_unit_price      Decimal
  order_item_quantity        Int
  order_item_subtotal        Decimal

  order                      Order     @relation(fields: [order_item_order_id], references: [order_id], onDelete: Cascade)

  @@map("order_item")

  @@index([order_item_order_id])
  @@index([order_item_sku])
  @@index([order_item_serial_number])
}


// ========================================
// 3. ORDER PROCESSING STATUS (MASTERDATA)
// ========================================
//
// 1, PENDING, Chờ xác nhận
// 2, CONFIRMED, Đã xác nhận
// 3, PROCESSING, Đang xử lý
// 4, READY_FOR_PICKUP, Sẵn sàng nhận hàng
// 5, SHIPPING, Đang giao hàng
// 6, DELIVERED, Đã giao hàng
// 7, COMPLETED, Hoàn thành
// 8, CANCELLED, Đã hủy
// 9, FAILED, Thất bại
//

model OrderProcessingStatus {
  order_processing_status_id   Int      @id @default(autoincrement())
  order_processing_status_code String   @unique
  order_processing_status_name String

  order                      Order[]

  @@map("order_processing_status")
}


// ========================================
// 4. ORDER PAYMENT STATUS (MASTERDATA)
// ========================================
//
// 1, PENDING, Chưa thanh toán
// 2, PAID, Đã thanh toán
// 3, FAILED, Thanh toán thất bại
// 4, REFUNDED, Đã hoàn tiền
//

model OrderPaymentStatus {
  order_payment_status_id   Int      @id @default(autoincrement())
  order_payment_status_code String   @unique
  order_payment_status_name String

  order                    Order[]

  @@map("order_payment_status")
}


// ========================================
// 5. ORDER DELIVERY METHOD (MASTERDATA)
// ========================================
//
// 1, HOME_DELIVERY, Giao hàng tận nơi
// 2, STORE_PICKUP, Nhận tại cửa hàng
//

model OrderDeliveryMethod {
  delivery_method_id   Int      @id @default(autoincrement())
  delivery_method_code String   @unique
  delivery_method_name String

  order                Order[]

  @@map("order_delivery_method")
}


// ========================================
// 6. ORDER PAYMENT METHOD (MASTERDATA)
// ========================================
//
// 1, COD, Thanh toán khi nhận hàng
// 2, MOMO, Thanh toán qua MOMO
// 3, VNPAY, Thanh toán qua VNPAY
//

model OrderPaymentMethod {
  payment_method_id     Int      @id @default(autoincrement())
  payment_method_code   String   @unique
  payment_method_name   String
  payment_method_status Boolean  @default(true)

  order                 Order[]

  @@map("order_payment_method")
}

// ========================================
// 6. OutboxEvent
// ========================================
model OutboxEvent {
  outbox_event_id          Int       @id @default(autoincrement())
  outbox_event_type        String
  outbox_event_payload     Json
  outbox_event_status      String    @default("PENDING")
  outbox_event_retry_count Int       @default(0)
  outbox_event_created_at  DateTime  @default(now())
  outbox_event_published_at DateTime?

  @@index([outbox_event_status])
  @@map("outbox_event")
}