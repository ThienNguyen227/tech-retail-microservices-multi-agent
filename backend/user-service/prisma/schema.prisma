generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  user_id                 BigInt          @id @default(autoincrement())
  user_name               String          @db.VarChar(50)
  user_phone              String          @unique @db.VarChar(20)
  user_email              String          @unique @db.VarChar(255)
  user_password_hash      String          @db.VarChar(255)
  user_type               String          @db.VarChar(20)
  user_status             String          @default("ACTIVE") @db.VarChar(20)
  user_created_at         DateTime        @default(now())
  user_updated_at         DateTime        @updatedAt

  Sessions                Sessions[]
  User_Roles              User_Roles[]
}

model Sessions {
  session_id             String          @id @db.VarChar(36)
  session_user_id        BigInt
  session_refresh_token_hash String       @db.VarChar(255)
  session_device_info    String?         @db.VarChar(255)
  session_ip_address     String?         @db.VarChar(45)
  session_expires_at     DateTime
  session_created_at     DateTime        @default(now())
  session_last_activity_at DateTime      @updatedAt @default(now())
  session_revoked_at     DateTime?

  user                   Users           @relation(fields: [session_user_id], references: [user_id], onDelete: Cascade)

  @@index([session_user_id], name: "idx_sessions_user_id")
  @@index([session_expires_at], name: "idx_sessions_expires_at")
}

// MASTER DATA
/// 1, CUSTOMER
/// 2, ADMIN
/// 3, MANAGER
/// 4, EMPLOYEE
model Roles {
  role_id                BigInt          @id @default(autoincrement())
  role_name              String          @unique @db.VarChar(50)
  role_description       String?         @db.VarChar(255)
  role_created_at        DateTime        @default(now())

  User_Roles             User_Roles[]
  Role_Permissions       Role_Permissions[]
}

// MASTER DATA
/// 1, user-list:read, user-service, read
model Permissions {
  permission_id          BigInt          @id @default(autoincrement())
  permission_name        String          @unique @db.VarChar(100)
  permission_resource    String          @db.VarChar(50)
  permission_action      String          @db.VarChar(50)

  Role_Permissions       Role_Permissions[]
}

model User_Roles {
  user_id                BigInt
  role_id                BigInt
  assigned_at            DateTime        @default(now())

  user                   Users           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role                   Roles           @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model Role_Permissions {
  role_id                BigInt
  permission_id          BigInt
  assigned_at            DateTime        @default(now())

  role                   Roles           @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  permission             Permissions     @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)

  @@id([role_id, permission_id])
}