generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// 1. PAYMENT
// ========================================

model Payment {
  payment_id                  Int      @id @default(autoincrement())

  payment_order_id            Int      // LR -> Order-Service (order_id)
  payment_order_code          String

  payment_user_id             Int      // LR -> User-Service (user_id)

  payment_amount              Decimal
  payment_currency            String   @default("VND")

  payment_payment_method_id   Int
  payment_status_id           Int

  payment_created_at          DateTime @default(now())
  payment_updated_at          DateTime @updatedAt

  // Relations
  payment_method              PaymentMethod @relation(fields: [payment_payment_method_id], references: [payment_method_id])

  payment_status              PaymentStatus @relation(fields: [payment_status_id], references: [payment_status_id])

  payment_transaction         PaymentTransaction[]

  @@map("payment")

  @@index([payment_order_id])
  @@index([payment_order_code])
  @@index([payment_user_id])
  @@index([payment_payment_method_id])
  @@index([payment_status_id])
}


// ========================================
// 2. PAYMENT TRANSACTION
// ========================================

model PaymentTransaction {
  payment_transaction_id             Int      @id @default(autoincrement())

  payment_transaction_payment_id     Int

  payment_transaction_transaction_code String @unique

  payment_transaction_gateway_transaction_id String?

  payment_transaction_amount         Decimal
  payment_transaction_currency       String   @default("VND")

  payment_transaction_status_id      Int

  // Request/response information
  payment_transaction_gateway_response_code String?
  payment_transaction_gateway_message      String?

  payment_transaction_gateway_response     Json?

  payment_transaction_created_at     DateTime @default(now())
  payment_transaction_updated_at     DateTime @updatedAt

  // Relations
  payment                         Payment @relation(fields: [payment_transaction_payment_id],references: [payment_id], onDelete: Cascade)

  payment_status                  PaymentStatus @relation(fields: [payment_transaction_status_id], references: [payment_status_id])

  @@map("payment_transaction")

  @@index([payment_transaction_payment_id])
  @@index([payment_transaction_gateway_transaction_id])
  @@index([payment_transaction_status_id])
}


// ========================================
// 3. PAYMENT STATUS (MASTERDATA)
// ========================================
//
// 1, PENDING, Đang chờ thanh toán
// 2, SUCCESS, Thanh toán thành công
// 3, FAILED, Thanh toán thất bại
// 4, CANCELLED, Đã hủy

model PaymentStatus {
  payment_status_id   Int      @id @default(autoincrement())
  payment_status_code String   @unique
  payment_status_name String

  payment             Payment[]
  payment_transaction PaymentTransaction[]

  @@map("payment_status")
}


// ========================================
// 4. PAYMENT METHOD (MASTERDATA)
// ========================================
//
// 1, COD
// 2, MOMO
// 3, VNPAY

model PaymentMethod {
  payment_method_id       Int      @id @default(autoincrement())
  payment_method_code     String   @unique
  payment_method_name     String

  payment_method_status   Boolean  @default(true)

  payment               Payment[]

  @@map("payment_method")
}