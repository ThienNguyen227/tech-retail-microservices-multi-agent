{
  "expo": {
    "name": "SmartHub",
    "slug": "smarthub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smarthub-icon.png",
    "scheme": "smarthub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/smarthub-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#073B4C",
        "foregroundImage": "./assets/images/smarthub-icon.png",
        "monochromeImage": "./assets/images/smarthub-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/smarthub-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#073B4C",
          "image": "./assets/images/smarthub-splash.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
